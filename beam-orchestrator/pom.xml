<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yourco.beam</groupId>
        <artifactId>beam-pipeline-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>beam-orchestrator</artifactId>
    <name>Beam Orchestrator — DAG-triggered run planner</name>
    <description>
        Standalone orchestration JAR. Triggered by Airflow before the pipeline JAR.
        Reads parameter_store to identify what sources / reports to run, resolves the
        period, creates task rows in BigQuery, and drops a manifest JSON to GCS for
        the DAG to read and fan out into individual pipeline invocations.

        Zero Apache Beam dependency — no Dataflow, no PipelineOptions.
        Extension points (PeriodResolver, RunScheduleResolver, TaskRepository,
        ManifestWriter) are all interfaces; swap implementations without touching
        the core orchestration logic.
    </description>

    <dependencies>

        <!-- GCP: BigQuery (reads parameter_store, writes task rows) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquery</artifactId>
        </dependency>

        <!-- GCP: GCS (writes manifest JSON file) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>

        <!-- JSON serialisation (manifest, extra params) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Fat JAR: beam-orchestrator-bundled.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>beam-orchestrator-bundled</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.yourco.beam.orchestrator.OrchestratorMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
